# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ── Kafka Topics ──────────────────────────────────────────────────────────────
TOPIC_RAW_TRANSACTIONS=raw-transactions
TOPIC_ENRICHED_TRANSACTIONS=enriched-transactions
TOPIC_AGENT_VERDICTS=agent-verdicts
TOPIC_TRAINING_DATA=training-data

# ── Feature Store (Feast + Redis) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
FEAST_REGISTRY_PATH=./feature_repo/registry.db
FEAST_ONLINE_STORE_TYPE=redis

# ── Spark + Delta Lake ────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
# Delta Lake lakehouse base path (S3A → MinIO)
DELTA_LAKE_BASE=s3a://fraud-lake
# MinIO endpoint (used by Spark S3A + MLflow)
MINIO_ENDPOINT=http://minio:9000

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection
MLFLOW_MODEL_NAME=fraud-classifier
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_ARTIFACT_ROOT=s3://mlflow/

# ── PostgreSQL (Airflow metadata + MLflow backend) ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=changeme_in_production
AIRFLOW_DB=airflow
MLFLOW_DB=mlflow

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_in_production
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_in_production

# ── LLM / Agent ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
PROMETHEUS_PORT=8000

# ── Agent Service Ports ───────────────────────────────────────────────────────
VELOCITY_AGENT_PORT=8001
GEOLOCATION_AGENT_PORT=8002
BEHAVIORAL_AGENT_PORT=8003
NETWORK_AGENT_PORT=8004
SUPERVISOR_AGENT_PORT=8005

# ── SLA Thresholds ────────────────────────────────────────────────────────────
MAX_DECISION_LATENCY_MS=200
FRAUD_SCORE_THRESHOLD=0.75
